# Vercel Postgres Environment Variables
# Get these by running: vercel env pull .env.local

# Connection pooling (use this for Prisma queries)
POSTGRES_PRISMA_URL="postgresql://..."

# Direct connection (use this for migrations)
POSTGRES_URL_NON_POOLING="postgresql://..."

# Standard connection string
POSTGRES_URL="postgresql://..."

# Optional: For direct @vercel/postgres queries
POSTGRES_DATABASE="vercel-postgres"
POSTGRES_HOST="..."
POSTGRES_PASSWORD="..."
POSTGRES_USER="..."

# Resend Email API
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY="re_..."

# ─── Virtualeagues OAuth (required for VL sign-in) ─────────────────────────
# Feature flag: set to "true" to expose the "Sign in with Virtualeagues"
# button and mount the /api/auth/virtualeagues/* routes. When false (or
# unset), the button is hidden, the routes return 404, and VL_CLIENT_ID/
# VL_CLIENT_SECRET/VL_REDIRECT_URI are unused.
NEXT_PUBLIC_VL_LOGIN_ENABLED="false"

# Get these from the VL OAuth app dashboard.
VL_CLIENT_ID="va_..."
VL_CLIENT_SECRET="..."
# Per-environment redirect URI. Must be registered in the VL app's allowed
# redirect URIs list (exact match — scheme, host, port, path all matter).
#   Dev:  http://localhost:3000/auth/virtualeagues/callback
#   Prod: https://<your-host>/auth/virtualeagues/callback
VL_REDIRECT_URI="http://localhost:3000/auth/virtualeagues/callback"

# ─── Virtualeagues OAuth (optional — defaults to virtualeagues.com) ────────
# Only set if VL changes their endpoints, or to override scopes.
# VL_AUTHORIZE_URL="https://www.virtualeagues.com/oauth/authorize"
# VL_TOKEN_URL="https://www.virtualeagues.com/api/oauth/token"
# VL_USERINFO_URL="https://www.virtualeagues.com/api/oauth/user"
# VL_SCOPES="profile:read email:read"

# ─── Internal API (called server-to-server by zenko-mono) ──────────────────
# Shared bearer token protecting /api/internal/waitlist/{lookup,mark-registered}.
# Must match the value set as ZENKO_INTERNAL_TOKEN on the zenko-mono backend.
# When unset, the internal endpoints return 503 (fail-closed).
# Generate locally with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZENKO_INTERNAL_TOKEN=""

# ─── Loops (loops.so) lifecycle email ──────────────────────────────────────
# Audience + sender for the waitlist->registration funnel. When LOOPS_API_KEY is
# unset (local dev, preview), every Loops call is a silent no-op — signup and
# status changes work exactly as before, nothing is emailed.
#
# IMPORTANT: use a SEPARATE key (ideally a separate workspace) per environment.
# Unlike analytics, a wrong-key write emails a real person — staging must not
# share production's key. Custom contact properties must be created in the
# workspace first: run `npx tsx scripts/loops-bootstrap.ts` once per workspace.
LOOPS_API_KEY=""
# The beta mailing list id contacts are added to (found in the Loops dashboard).
# Carries the unsubscribe relationship; attached only on waitlist_joined.
LOOPS_MAILING_LIST_ID=""
# Set to "1" to log Loops payloads instead of sending — how the integration is
# exercised locally without touching a real workspace.
LOOPS_DRY_RUN=""
